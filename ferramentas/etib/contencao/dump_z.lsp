;; Dump 3D para topografia: INSERT (ponto 3D + atributos), POLYLINE 2D/3D (vértices com z e elevação),
;; LWPOLYLINE (elevação 38). Saída em DUMPZ_TSV.  Colunas: tipo <TAB> layer <TAB> dados
(defun f3 (p) (strcat (rtos (car p) 2 4) "," (rtos (cadr p) 2 4) "," (rtos (if (caddr p) (caddr p) 0.0) 2 4)))
(defun c:dumpz ( / f ss i e ed typ lay s a v)
  (setvar "TILEMODE" 1)
  (setq f (open (getenv "DUMPZ_TSV") "w"))
  (setq ss (ssget "X" '((410 . "Model") (-4 . "<OR") (0 . "INSERT") (0 . "POLYLINE") (0 . "LWPOLYLINE") (-4 . "OR>"))))
  (setq i 0)
  (if ss
    (repeat (sslength ss)
      (setq e (ssname ss i) ed (entget e) typ (cdr (assoc 0 ed)) lay (cdr (assoc 8 ed)) s nil)
      (cond
        ((= typ "INSERT")
         (setq s (strcat (f3 (cdr (assoc 10 ed))) " " (cdr (assoc 2 ed))))
         (if (= (cdr (assoc 66 ed)) 1)
           (progn
             (setq a (entnext e))
             (while (and a (= (cdr (assoc 0 (entget a))) "ATTRIB"))
               (setq s (strcat s " |" (cdr (assoc 2 (entget a))) "=" (cdr (assoc 1 (entget a)))))
               (setq a (entnext a))))))
        ((= typ "LWPOLYLINE")
         (setq s (strcat "elev=" (rtos (if (assoc 38 ed) (cdr (assoc 38 ed)) 0.0) 2 4) " "))
         (foreach v ed (if (= (car v) 10) (setq s (strcat s (rtos (cadr v) 2 3) "," (rtos (caddr v) 2 3) ";")))))
        ((= typ "POLYLINE")
         (setq s "") (setq a (entnext e))
         (while (and a (= (cdr (assoc 0 (entget a))) "VERTEX"))
           (setq s (strcat s (f3 (cdr (assoc 10 (entget a)))) ";"))
           (setq a (entnext a))))
      )
      (if s (write-line (strcat typ "\t" lay "\t" s) f))
      (setq i (1+ i))))
  (close f)
  (princ))
