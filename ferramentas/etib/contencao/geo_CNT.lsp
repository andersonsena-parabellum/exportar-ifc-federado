(defun c:geo ( / ss)
  (setvar "TILEMODE" 1)
  (setvar "CTAB" "Model")
  (command "_.-LAYER" "_T" "*" "_ON" "*" "_U" "*" "")
  (setq ss (ssget "X" '((410 . "Model"))))
  (princ (strcat "\nENTIDADES=" (itoa (sslength ss))))
  (command "_.ROTATE" ss "" "0,0" "0.0000202357")
  (setq ss (ssget "X" '((410 . "Model"))))
  (command "_.MOVE" ss "" "0,0" "561500.953496,8657755.620724")
  (command "_.ZOOM" "_E")
  (princ))