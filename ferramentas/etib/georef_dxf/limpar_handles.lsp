;; Apaga as entidades pelos handles (lista em LIMPA_H, separados por espaço) e grava em LIMPA_OUT.
;; Os handles saem do handles_longe.py (geometria inteira a mais de 20 km da obra = lixo perdido).
(defun lh:split (s / i out tok c)
  (setq out nil tok "" i 1)
  (while (<= i (strlen s))
    (setq c (substr s i 1))
    (if (= c " ") (progn (if (/= tok "") (setq out (cons tok out))) (setq tok "")) (setq tok (strcat tok c)))
    (setq i (1+ i)))
  (if (/= tok "") (setq out (cons tok out)))
  (reverse out))
(defun c:limpahandles ( / n e h)
  (setvar "TILEMODE" 1)
  (setvar "CMDECHO" 0)
  (command "_.-LAYER" "_U" "*" "")
  (setq n 0)
  (foreach h (lh:split (getenv "LIMPA_H"))
    (if (setq e (handent h))
      (progn (princ (strcat "\n  apagado " h ": " (cdr (assoc 0 (entget e))) " / " (cdr (assoc 8 (entget e))))) (entdel e) (setq n (1+ n)))))
  (princ (strcat "\nLIMPEZA: " (itoa n) " entidades apagadas\n"))
  (command "_.SAVEAS" "2018" (getenv "LIMPA_OUT"))
  (princ))
