;; Desenha a revisão R01 numa CÓPIA do DWG de projeto e grava como arquivo novo.
;; Variáveis de ambiente: REV_CMD = arquivo de comandos (UTF-8, campos separados por TAB), REV_OUT = DWG de saída.
;; Comandos: LAYER nome cor tipo_linha | PL layer fechado x y x y ... | TX layer x y h rot texto | MT layer x y h largura texto | CLOUD layer x y r
(defun r01:split (s / i out tok c)
  (setq out nil tok "" i 1)
  (while (<= i (strlen s))
    (setq c (substr s i 1))
    (if (= c "\t") (progn (setq out (cons tok out)) (setq tok "")) (setq tok (strcat tok c)))
    (setq i (1+ i)))
  (reverse (cons tok out)))
(defun r01:estilo ()
  (if (not (tblsearch "STYLE" "R01"))
    (entmake '((0 . "STYLE") (100 . "AcDbSymbolTableRecord") (100 . "AcDbTextStyleTableRecord") (2 . "R01") (70 . 0)
               (40 . 0.0) (41 . 1.0) (50 . 0.0) (71 . 0) (42 . 0.3) (3 . "arial.ttf") (4 . "")))))
(defun r01:layer (nm cor lt)
  (if (and (/= lt "Continuous") (not (tblsearch "LTYPE" lt)))
    (command "_.-LINETYPE" "_L" lt "acadiso.lin" ""))
  (if (not (tblsearch "LAYER" nm))
    (entmake (list '(0 . "LAYER") '(100 . "AcDbSymbolTableRecord") '(100 . "AcDbLayerTableRecord") (cons 2 nm) '(70 . 0)
                   (cons 62 cor) (cons 6 (if (tblsearch "LTYPE" lt) lt "Continuous")) '(370 . 35)))))
(defun r01:pl (lay fech xy / pts l)
  (setq pts nil)
  (while xy (setq pts (cons (list (atof (car xy)) (atof (cadr xy))) pts) xy (cddr xy)))
  (setq pts (reverse pts))
  (setq l (list '(0 . "LWPOLYLINE") '(100 . "AcDbEntity") (cons 8 lay) '(100 . "AcDbPolyline") (cons 90 (length pts)) (cons 70 (if (= fech "1") 1 0)) '(43 . 0.0)))
  (foreach p pts (setq l (append l (list (cons 10 p)))))
  (entmake l))
(defun r01:cloud (lay x y r / n i a l)
  (setq n (max 8 (fix (/ (* 2 pi r) (* 0.6 r 0.9)))) l (list '(0 . "LWPOLYLINE") '(100 . "AcDbEntity") (cons 8 lay) '(100 . "AcDbPolyline") (cons 90 12) '(70 . 1) '(43 . 0.0)))
  (setq i 0)
  (repeat 12
    (setq a (/ (* 2 pi i) 12.0))
    (setq l (append l (list (cons 10 (list (+ x (* r (cos a))) (+ y (* r (sin a))))) '(42 . 0.55))))
    (setq i (1+ i)))
  (entmake l))
(defun r01:tx (lay x y h rt txt)
  (entmake (list '(0 . "TEXT") '(100 . "AcDbEntity") (cons 8 lay) '(100 . "AcDbText") (list 10 x y 0.0) (cons 40 h) (cons 1 txt) (cons 50 rt) '(7 . "R01") '(100 . "AcDbText"))))
(defun r01:mt (lay x y h w txt)
  (entmake (list '(0 . "MTEXT") '(100 . "AcDbEntity") (cons 8 lay) '(100 . "AcDbMText") (list 10 x y 0.0) (cons 40 h) (cons 41 w) '(71 . 1) (cons 1 txt) '(7 . "R01"))))
(defun c:revr01 ( / f ln c n saida)
  (setvar "CMDECHO" 0) (setvar "TILEMODE" 1)
  (r01:estilo)
  (setq f (open (getenv "REV_CMD") "r" "utf8") n 0)
  (while (setq ln (read-line f))
    (setq c (r01:split ln))
    (cond
      ((= (car c) "LAYER") (r01:layer (nth 1 c) (atoi (nth 2 c)) (nth 3 c)))
      ((= (car c) "PL") (r01:pl (nth 1 c) (nth 2 c) (cdddr c)))
      ((= (car c) "CLOUD") (r01:cloud (nth 1 c) (atof (nth 2 c)) (atof (nth 3 c)) (atof (nth 4 c))))
      ((= (car c) "TX") (r01:tx (nth 1 c) (atof (nth 2 c)) (atof (nth 3 c)) (atof (nth 4 c)) (atof (nth 5 c)) (nth 6 c)))
      ((= (car c) "MT") (r01:mt (nth 1 c) (atof (nth 2 c)) (atof (nth 3 c)) (atof (nth 4 c)) (atof (nth 5 c)) (nth 6 c))))
    (setq n (1+ n)))
  (close f)
  (command "_.ZOOM" "_E")
  (setq saida (getenv "REV_OUT"))
  (princ (strcat "\nREVR01: " (itoa n) " linhas -> " saida "\n"))
  (command "_.SAVEAS" "2018" saida)
  (princ))
