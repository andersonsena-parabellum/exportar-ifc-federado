(defun c:geo ( / ss)
  (setvar "TILEMODE" 1)
  (setvar "CTAB" "Model")
  (command "_.-LAYER" "_T" "*" "_ON" "*" "_U" "*" "")
  (setq ss (ssget "X" '((410 . "Model"))))
  (princ (strcat "
ENTIDADES=" (itoa (sslength ss))))
  (command "_.ROTATE" ss "" "0,0" "0.04622337222261859")
  (setq ss (ssget "X" '((410 . "Model"))))
  (command "_.MOVE" ss "" "0,0" "561101.41134274,8657866.33424685")
  (command "_.ZOOM" "_E")
  (princ))
