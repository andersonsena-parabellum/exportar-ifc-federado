;; Dump geometrico/textual do DWG de drenagem (modelo) para TSV; usa NESTTAG como sufixo do arquivo
(defun fmt (x) (rtos x 2 4))
(defun pt2 (p) (strcat (fmt (car p)) "," (fmt (cadr p))))
(defun c:dump ( / f ss i e ed typ lay s txt v)
  (setvar "TILEMODE" 1)
  (setq f (open (strcat "D:/Projeto Modelagem/FERRAMENTAS/eletrica/dump_" (getenv "NESTTAG") ".tsv") "w"))
  (setq ss (ssget "X" '((410 . "Model") (-4 . "<NOT") (8 . "09-PISO,ARQ_DEMOLI*,0") (-4 . "NOT>"))))
  (setq i 0)
  (repeat (sslength ss)
    (setq e (ssname ss i) ed (entget e) typ (cdr (assoc 0 ed)) lay (cdr (assoc 8 ed)) s nil)
    (cond
      ((= typ "LINE")
       (setq s (strcat (pt2 (cdr (assoc 10 ed))) " " (pt2 (cdr (assoc 11 ed))))))
      ((= typ "LWPOLYLINE")
       (setq s (strcat "c=" (itoa (logand 1 (cdr (assoc 70 ed)))) " "))
       (foreach v ed (if (= (car v) 10) (setq s (strcat s (pt2 (cdr v)) ";")))))
      ((= typ "CIRCLE")
       (setq s (strcat (pt2 (cdr (assoc 10 ed))) " r=" (fmt (cdr (assoc 40 ed))))))
      ((= typ "ARC")
       (setq s (strcat (pt2 (cdr (assoc 10 ed))) " r=" (fmt (cdr (assoc 40 ed))) " a=" (rtos (cdr (assoc 50 ed)) 2 6) "," (rtos (cdr (assoc 51 ed)) 2 6))))
      ((= typ "MLINE")
       (setq s "")
       (foreach v ed (if (= (car v) 11) (setq s (strcat s (pt2 (cdr v)) ";")))))
      ((or (= typ "MTEXT") (= typ "TEXT"))
       (setq txt "")
       (foreach v ed (if (or (= (car v) 3)) (setq txt (strcat txt (cdr v)))))
       (setq txt (strcat txt (cdr (assoc 1 ed))))
       (setq s (strcat (pt2 (cdr (assoc 10 ed))) " h=" (rtos (cdr (assoc 40 ed)) 2 3) " rot=" (if (assoc 50 ed) (rtos (cdr (assoc 50 ed)) 2 4) "0") " " txt)))
      ((= typ "INSERT")
       (setq s (strcat (pt2 (cdr (assoc 10 ed))) " rot=" (rtos (cdr (assoc 50 ed)) 2 6) " sx=" (rtos (cdr (assoc 41 ed)) 2 4) " " (cdr (assoc 2 ed)))))
      ((= typ "HATCH")
       (setq s (strcat (pt2 (cdr (assoc 10 ed))) " " (cdr (assoc 2 ed)))))
      ((= typ "MULTILEADER") (setq s "-"))
    )
    (if s (write-line (strcat typ "\t" lay "\t" (cdr (assoc 5 ed)) "\t" s) f))
    (setq i (1+ i)))
  (close f)
  (princ))


