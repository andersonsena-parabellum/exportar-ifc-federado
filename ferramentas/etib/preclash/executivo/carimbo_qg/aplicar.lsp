;; Troca o carimbo da prancha pelo carimbo da construtora as built (bloco CARIMBO_QG_ASBUILT.dwg), na cópia aberta no console.
;; Variável de ambiente CARQG_CMD = arquivo de comandos (campos separados por TAB; texto não ASCII já vem como \U+XXXX):
;;   DEL h                          apaga a entidade de handle h (carimbo antigo: linhas, textos, logos, linhas de revisão)
;;   ATT TAG valor [largura]        valor do atributo TAG do bloco (antes do INS); largura = fator de largura para caber na caixa
;;   INS layout x y escala caminho  insere o bloco no papel do layout, canto inferior direito em (x, y)
;;   LN x1 y1 x2 y2                 linha do quadro de revisões (layer ARQ_TXT)
;;   TX x y h alinh estilo texto    texto do quadro de revisões (alinh. 0 esquerda, 1 centro; vertical no meio)
(defun carqg:split (s / i out tok c)
  (setq out nil tok "" i 1)
  (while (<= i (strlen s))
    (setq c (substr s i 1))
    (if (= c "\t") (progn (setq out (cons tok out)) (setq tok "")) (setq tok (strcat tok c)))
    (setq i (1+ i)))
  (reverse (cons tok out)))
(defun carqg:ins (lay x y s path / ins e d v un)
  (setvar "CTAB" lay) (setvar "ATTREQ" 0) (setvar "ATTDIA" 0)
  (if (tblsearch "LAYER" "ARQ_TXT") (setvar "CLAYER" "ARQ_TXT"))
  (setq un (getvar "INSUNITS")) (setvar "INSUNITS" 4)        ; mm, como o bloco: sem conversão de unidade, vale a escala dada
  (if (tblsearch "BLOCK" "CARIMBO_QG_ASBUILT")
    (command "_.-INSERT" "CARIMBO_QG_ASBUILT" (list x y 0.0) s s 0)
    (command "_.-INSERT" path (list x y 0.0) s s 0))
  (setvar "INSUNITS" un)
  (setq ins (entlast) e (entnext ins))
  (while (and e (= (cdr (assoc 0 (setq d (entget e)))) "ATTRIB"))
    (if (setq v (cdr (assoc (cdr (assoc 2 d)) carqg:vals)))
      (progn
        (setq d (subst (cons 1 (car v)) (assoc 1 d) d))
        (if (cadr v)                                   ; o ATTRIB com largura 1 não traz o grupo 41
          (setq d (if (assoc 41 d) (subst (cons 41 (atof (cadr v))) (assoc 41 d) d) (append d (list (cons 41 (atof (cadr v))))))))
        (entmod d)))
    (setq e (entnext e)))
  (entupd ins)
  (princ (strcat "\nCARQG_INS " lay)))
(defun carqg:ln (x1 y1 x2 y2)
  (entmake (list '(0 . "LINE") '(100 . "AcDbEntity") '(67 . 1) (cons 410 (getvar "CTAB")) '(8 . "ARQ_TXT") '(100 . "AcDbLine")
                 (list 10 x1 y1 0.0) (list 11 x2 y2 0.0))))
(defun carqg:tx (x y h hj st txt)
  (entmake (list '(0 . "TEXT") '(100 . "AcDbEntity") '(67 . 1) (cons 410 (getvar "CTAB")) '(8 . "ARQ_TXT") '(100 . "AcDbText")
                 (list 10 x y 0.0) (cons 40 h) (cons 1 txt) (cons 7 (if (tblsearch "STYLE" st) st "Standard")) (cons 72 hj) (list 11 x y 0.0)
                 '(100 . "AcDbText") '(73 . 2))))
(defun c:carqgapl ( / f ln c n e)
  (setvar "CMDECHO" 0) (setvar "OSMODE" 0) (setvar "IMAGEFRAME" 2)   ; contorno das imagens não sai na plotagem
  (setq carqg:vals nil n 0)
  (setq f (open (getenv "CARQG_CMD") "r"))
  (while (setq ln (read-line f))
    (setq c (carqg:split ln))
    (cond
      ((= (car c) "DEL") (if (setq e (handent (nth 1 c))) (progn (entdel e) (setq n (1+ n)))))
      ((= (car c) "ATT") (setq carqg:vals (cons (list (nth 1 c) (nth 2 c) (nth 3 c)) carqg:vals)))
      ((= (car c) "INS") (princ (strcat "\nCARQG_DEL " (itoa n))) (carqg:ins (nth 1 c) (atof (nth 2 c)) (atof (nth 3 c)) (atof (nth 4 c)) (nth 5 c)))
      ((= (car c) "LN") (carqg:ln (atof (nth 1 c)) (atof (nth 2 c)) (atof (nth 3 c)) (atof (nth 4 c))))
      ((= (car c) "TX") (carqg:tx (atof (nth 1 c)) (atof (nth 2 c)) (atof (nth 3 c)) (atoi (nth 4 c)) (nth 5 c) (nth 6 c)))))
  (close f)
  (princ "\nCARQG_OK")
  (princ))
