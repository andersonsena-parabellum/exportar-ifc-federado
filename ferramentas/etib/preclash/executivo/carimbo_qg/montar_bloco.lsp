;; Monta o bloco CARIMBO_QG_ASBUILT.dwg a partir da exportação DWG da família Revit
;; "ARQ_SIMB_CARIMBO_PROJETO EXECUTIVO-QG AS BUILT.rfa" (folha da família, papel em mm).
;; Rodar no accoreconsole numa CÓPIA de fonte\carimbo_qg_export_revit.dwg. Variável de ambiente CARQG_OUT = DWG do bloco.
;; - cotas da família saem; rótulos (layer NPLT) viram atributos na mesma posição, estilo e alinhamento;
;; - tudo vai para o layer ARQ_TXT (o do carimbo das pranchas da construtora: na prancha vale a definição dela);
;; - imagens com caminho só pelo nome (CARIMBO_QG_logo_*.png ao lado do DWG da prancha);
;; - ponto base = canto inferior direito do carimbo (299,5; -23,4), o mesmo canto do carimbo antigo.
(defun carqg:att (tag prompt def x y h st hj)
  (entmake (list '(0 . "ATTDEF") '(100 . "AcDbEntity") '(67 . 1) '(8 . "ARQ_TXT") '(100 . "AcDbText")
                 (list 10 x y 0.0) (cons 40 h) (cons 1 def) (cons 7 st) (cons 41 (cdr (assoc 41 (tblsearch "STYLE" st)))) (cons 72 hj) (list 11 x y 0.0)
                 '(100 . "AcDbAttributeDefinition") (cons 3 prompt) (cons 2 tag) '(70 . 0) '(74 . 3))))
;; primeiro layout de papel (o console não tem layoutlist)
(defun carqg:layout ( / d r)
  (setq d (dictsearch (namedobjdict) "ACAD_LAYOUT") r nil)
  (foreach g d (if (and (= (car g) 3) (/= (strcase (cdr g)) "MODEL") (not r)) (setq r (cdr g))))
  r)
(defun c:carqg ( / ss s2 i e d typ lay dic it nm out)
  (setvar "CMDECHO" 0) (setvar "OSMODE" 0)
  (setvar "CTAB" (carqg:layout))
  (if (not (tblsearch "LAYER" "ARQ_TXT"))
    (entmake '((0 . "LAYER") (100 . "AcDbSymbolTableRecord") (100 . "AcDbLayerTableRecord") (2 . "ARQ_TXT") (70 . 0) (62 . 7) (6 . "Continuous") (370 . 25))))
  (setq ss (ssget "_X" '((67 . 1))) i 0)
  (while (< i (sslength ss))
    (setq e (ssname ss i) d (entget e) typ (cdr (assoc 0 d)) lay (cdr (assoc 8 d)))
    (cond ((= typ "DIMENSION") (entdel e))
          ((and (= typ "MTEXT") (= lay "G-____-____-NPLT")) (entdel e))
          ((= typ "VIEWPORT") nil)
          (T (entmod (subst (cons 8 "ARQ_TXT") (assoc 8 d) d))))
    (setq i (1+ i)))
  ;;           tag             prompt                         padrão                                   x        y       h    estilo       alinh.
  (carqg:att "PROJETO"       "Nome do projeto"              "ESCOLA DE TEMPO INTEGRAL DA BAHIA"      127.497  52.273  3.5 "Arial_B_1" 0)
  (carqg:att "DISCIPLINA"    "Disciplina"                   "DISCIPLINA"                             126.716  43.062  3.5 "Arial_B_1" 0)
  (carqg:att "ENDERECO"      "Endere\\U+00E7o"                     "ENDERE\\U+00C7O:"                              127.463  34.405  2.5 "Arial_5"   0)
  (carqg:att "ETAPA"         "Etapa do projeto"             "PROJETO EXECUTIVO"                      126.872  17.247  4.0 "Arial_B_2" 0)
  (carqg:att "NOME_FOLHA"    "Nome da folha"                "PLANTA BAIXA"                           126.872   8.474  3.5 "Arial_B_1" 0)
  (carqg:att "FOLHA"         "Discipl_setor-folha_rev"      "XX_IMP-001_R00"                         273.915  14.122  4.5 "Arial_B"   1)
  (carqg:att "CODIGO"        "C\\U+00F3digo da folha"              "AA-CTR-MUN-LOC-ETIB-IMP-PE-XX-001-XXX-R00" 127.185 -5.977 4.0 "Arial_B_2" 0)
  (carqg:att "RESP_PROJETO"  "Respons\\U+00E1vel pelo projeto"     "-"                                      127.497 -15.365  1.6 "Arial_4"   0)
  (carqg:att "CAU_CREA"      "CAU/CREA do respons\\U+00E1vel"      "-"                                      210.000 -15.365  1.6 "Arial_4"   2)
  (carqg:att "COORDENADOR"   "Coordenador"                  "-"                                      212.957 -15.365  1.6 "Arial_4"   0)
  (carqg:att "DESENHISTA"    "Desenhista (CAD)"             "-"                                      257.172 -15.365  1.6 "Arial_4"   0)
  (carqg:att "DATA"          "Data"                         "00/00/0000"                             167.100 -20.055  1.6 "Arial_4"   2)
  (carqg:att "ESCALA"        "Escala"                       "1:000"                                  186.200 -19.824  2.0 "Arial_2"   1)
  (carqg:att "ARQUIVO"       "Arquivo"                      "-"                                      297.300 -20.092  1.5 "Arial_6"   2)
  ;; imagens: caminho só pelo nome do arquivo
  (if (setq dic (dictsearch (namedobjdict) "ACAD_IMAGE_DICT"))
    (foreach g dic
      (if (= (car g) 350)
        (progn
          (setq it (entget (cdr g)) nm (strcase (cdr (assoc 1 it))))
          (cond ((wcmatch nm "*-CONDER-*") (setq out "CARIMBO_QG_logo_CONDER.png"))
                ((wcmatch nm "*-GOV-*") (setq out "CARIMBO_QG_logo_GOVBA.png"))
                ((wcmatch nm "*-QG-*") (setq out "CARIMBO_QG_logo_QG.png"))
                (T (setq out nil)))
          (if out (entmod (subst (cons 1 out) (assoc 1 it) it)))))))
  ;; definição do bloco por entmake (o WBLOCK direto do papel deixa as entidades no papel do arquivo novo, e o INSERT sai vazio)
  ;; imagens primeiro: ficam por baixo das linhas e textos (o logo da construtora cobre o "CONTRATADA")
  (setq ss (ssget "_X" '((67 . 1) (0 . "IMAGE"))) i 0
        s2 (ssget "_X" '((67 . 1) (-4 . "<NOT") (-4 . "<OR") (0 . "VIEWPORT") (0 . "IMAGE") (-4 . "OR>") (-4 . "NOT>"))))
  (setq e 0) (while (< e (sslength s2)) (ssadd (ssname s2 e) ss) (setq e (1+ e)))
  (entmake '((0 . "BLOCK") (2 . "CARIMBO_QG_ASBUILT") (70 . 2) (10 299.5 -23.4 0.0)))
  (while (< i (sslength ss))
    (setq d (vl-remove-if '(lambda (g) (or (member (car g) '(-1 5 330 360 67 410 102)) (and (= (type (car g)) 'INT) (= (car g) 102))))
                          (entget (ssname ss i))))
    (if (not (entmake d)) (princ (strcat "\nCARQG falhou: " (cdr (assoc 0 d)))))
    (setq i (1+ i)))
  (entmake '((0 . "ENDBLK")))
  (princ (strcat "\nCARQG: " (itoa (sslength ss)) " entidades no bloco"))
  (command "_.-WBLOCK" (getenv "CARQG_OUT") "CARIMBO_QG_ASBUILT")
  (princ "\nCARQG: bloco gravado")
  (princ))
