;; Desenha a revisão R01 numa CÓPIA do DWG de projeto e grava como arquivo novo.
;; Variáveis de ambiente: REV_CMD = arquivo de comandos (UTF-8, campos separados por TAB), REV_OUT = DWG de saída.
;; Comandos: LAYER nome cor tipo_linha | PL layer fechado x y x y ... | TX layer x y h rot texto | MT layer x y h largura texto | CLOUD layer x y r
(defun r01:split (s / i out tok c)
  (setq out nil tok "" i 1)
  (while (<= i (strlen s))
    (setq c (substr s i 1))
    (if (= c "\t") (progn (setq out (cons tok out)) (setq tok "")) (setq tok (strcat tok c)))
    (setq i (1+ i)))
  (reverse (cons tok out)))
(defun r01:estilo ()
  (if (not (tblsearch "STYLE" "R01"))
    (entmake '((0 . "STYLE") (100 . "AcDbSymbolTableRecord") (100 . "AcDbTextStyleTableRecord") (2 . "R01") (70 . 0)
               (40 . 0.0) (41 . 1.0) (50 . 0.0) (71 . 0) (42 . 0.3) (3 . "arial.ttf") (4 . "")))))
(defun r01:layer (nm cor lt)
  (if (and (/= lt "Continuous") (not (tblsearch "LTYPE" lt)))
    (command "_.-LINETYPE" "_L" lt "acadiso.lin" ""))
  (if (not (tblsearch "LAYER" nm))
    (entmake (list '(0 . "LAYER") '(100 . "AcDbSymbolTableRecord") '(100 . "AcDbLayerTableRecord") (cons 2 nm) '(70 . 0)
                   (cons 62 cor) (cons 6 (if (tblsearch "LTYPE" lt) lt "Continuous")) '(370 . 35)))))
(defun r01:pl (lay fech xy / pts l)
  (setq pts nil)
  (while xy (setq pts (cons (list (atof (car xy)) (atof (cadr xy))) pts) xy (cddr xy)))
  (setq pts (reverse pts))
  (setq l (list '(0 . "LWPOLYLINE") '(100 . "AcDbEntity") (cons 8 lay) '(100 . "AcDbPolyline") (cons 90 (length pts)) (cons 70 (+ 128 (if (= fech "1") 1 0))) '(43 . 0.0)))
  (foreach p pts (setq l (append l (list (cons 10 p)))))
  (entmake l))
(defun r01:cloud (lay x y r / n i a l)
  (setq n (max 8 (fix (/ (* 2 pi r) (* 0.6 r 0.9)))) l (list '(0 . "LWPOLYLINE") '(100 . "AcDbEntity") (cons 8 lay) '(100 . "AcDbPolyline") (cons 90 12) '(70 . 1) '(43 . 0.0)))
  (setq i 0)
  (repeat 12
    (setq a (/ (* 2 pi i) 12.0))
    (setq l (append l (list (cons 10 (list (+ x (* r (cos a))) (+ y (* r (sin a))))) '(42 . 0.55))))
    (setq i (1+ i)))
  (entmake l))
(defun r01:tx (lay x y h rt txt)
  (entmake (list '(0 . "TEXT") '(100 . "AcDbEntity") (cons 8 lay) '(100 . "AcDbText") (list 10 x y 0.0) (cons 40 h) (cons 1 txt) (cons 50 rt) '(7 . "R01") '(100 . "AcDbText"))))
;; MTEXT sem fundo; texto longo vai em blocos de 250 caracteres no grupo 3 e o resto no grupo 1
;; (com mais de 250 caracteres no grupo 1 o entmake falha sem avisar)
(defun r01:mt (lay x y h w txt / l)
  (setq l (list '(0 . "MTEXT") '(100 . "AcDbEntity") (cons 8 lay) '(100 . "AcDbMText") (list 10 x y 0.0) (cons 40 h) (cons 41 w) '(71 . 1)))
  (while (> (strlen txt) 250)
    (setq l (append l (list (cons 3 (substr txt 1 250)))) txt (substr txt 251)))
  (entmake (append l (list (cons 1 txt) '(7 . "R01")))))
;; ---------------------------------------------------------------- executivo final (as built): mexe nas entidades da prancha
;; DEL h                       apaga a entidade de handle h
;; PLC h fechado x y x y ...   polilinha nova com layer, tipo/escala de linha, cor, espessura e largura da entidade h (molde)
;; REPL h x y x y ...          troca os vértices da polilinha h (mantém todas as propriedades)
;; MV h dx dy                  move a entidade h (texto, bloco/tag, caixa)
;; VTX h k x y                 move o vértice k da linha/polilinha h (k = -1: último)
;; TXC h x y rot texto         texto novo com layer, estilo, altura e cor do texto h (molde)
(defun r01:props (d keys / l)
  (setq l nil)
  (foreach k keys (if (assoc k d) (setq l (append l (list (assoc k d))))))
  l)
;; propriedades do original + "PorLayer" no que ele não declara: o entmake sem o grupo usa CELTYPE/CECOLOR/CELWEIGHT do
;; desenho (escola A EL-002 R03, 20/10/2026: trecho redesenhado saiu "Continuous" numa rede tracejada pela layer)
(defun r01:props_bl (d keys / l)
  (setq l (r01:props d keys))
  (if (and (member 6 keys) (not (assoc 6 d))) (setq l (append l '((6 . "ByLayer")))))
  (if (and (member 62 keys) (not (assoc 62 d)) (not (assoc 420 d))) (setq l (append l '((62 . 256)))))
  (if (and (member 370 keys) (not (assoc 370 d))) (setq l (append l '((370 . -1)))))
  l)
(defun r01:del (h / e) (if (setq e (handent h)) (entdel e)))
(defun r01:plc (h fech xy / e d l pts)
  (setq e (handent h))
  (if e
    (progn
      (setq d (entget e) pts nil)
      (while xy (setq pts (cons (list (atof (car xy)) (atof (cadr xy))) pts) xy (cddr xy)))
      (setq pts (reverse pts))
      (setq l (append (list '(0 . "LWPOLYLINE") '(100 . "AcDbEntity")) (r01:props_bl d '(8 6 62 370 48 420))
                      (list '(100 . "AcDbPolyline") (cons 90 (length pts)) (cons 70 (+ 128 (if (= fech "1") 1 0))))
                      (if (assoc 43 d) (list (assoc 43 d)) '((43 . 0.0)))))
      (foreach p pts (setq l (append l (list (cons 10 p)))))
      (entmake l))))
(defun r01:repl (h xy / e d l pts)
  (setq e (handent h))
  (if e
    (progn
      (setq d (entget e) pts nil)
      (while xy (setq pts (cons (list (atof (car xy)) (atof (cadr xy))) pts) xy (cddr xy)))
      (setq pts (reverse pts) l nil)
      (foreach g d (if (not (member (car g) '(10 40 41 42 91 90))) (setq l (append l (list g)))))
      ;; reconstrói: cabeçalho (sem 210), contagem e vértices novos (arcos/bulge do trecho viram retas)
      (setq l (append (vl-remove-if '(lambda (g) (= (car g) 210)) l) (list (cons 90 (length pts)))))
      (foreach p pts (setq l (append l (list (cons 10 p)))))
      (entmod l) (entupd e))))
(defun r01:mv (h dx dy / e)
  (if (setq e (handent h)) (command "_.MOVE" e "" '(0.0 0.0 0.0) (list (atof dx) (atof dy) 0.0))))
(defun r01:vtx (h k x y / e d n i out tipo)
  (setq e (handent h))
  (if e
    (progn
      (setq d (entget e) tipo (cdr (assoc 0 d)) k (atoi k))
      (cond
        ((= tipo "LINE")
         (setq d (subst (list (if (= k 0) 10 11) (atof x) (atof y) 0.0) (assoc (if (= k 0) 10 11) d) d))
         (entmod d))
        ((= tipo "LWPOLYLINE")
         (setq n (length (vl-remove-if-not '(lambda (g) (= (car g) 10)) d)) i 0 out nil)
         (if (< k 0) (setq k (1- n)))
         (foreach g d
           (if (= (car g) 10)
             (progn (setq out (cons (if (= i k) (list 10 (atof x) (atof y)) g) out)) (setq i (1+ i)))
             (setq out (cons g out))))
         (entmod (reverse out))))
      (entupd e))))
(defun r01:txc (h x y rt txt / e d)
  (setq e (handent h))
  (if e
    (progn
      (setq d (entget e))
      (entmake (append (list '(0 . "TEXT") '(100 . "AcDbEntity")) (r01:props_bl d '(8 62 420))
                       (list '(100 . "AcDbText") (list 10 (atof x) (atof y) 0.0) (cons 40 (cdr (assoc 40 d))) (cons 1 txt) (cons 50 (atof rt)))
                       (r01:props d (if (= (cdr (assoc 0 d)) "TEXT") '(7 41) '(7)))   ; no MTEXT o 41 é a largura da caixa, não o fator de largura
                       (list '(100 . "AcDbText")))))))
;; RT h x y ang                gira a entidade h em torno de (x, y), ang em graus (ex.: inverter a seta de fluxo: 180)
;; CPR h bx by nx ny ang       copia a entidade h levando (bx, by) para (nx, ny) e gira a cópia ang graus em torno de (nx, ny)
;; ST h texto                  troca o conteúdo do TEXT/MTEXT h (mantém posição, estilo e formatação da entidade)
(defun r01:rt (h x y a / e)
  (if (setq e (handent h)) (command "_.ROTATE" e "" (list (atof x) (atof y) 0.0) (atof a))))
(defun r01:cpr (h bx by nx ny a / e)
  (if (setq e (handent h))
    (progn
      (command "_.COPY" e "" (list (atof bx) (atof by) 0.0) (list (atof nx) (atof ny) 0.0))
      (if (/= (atof a) 0.0) (command "_.ROTATE" (entlast) "" (list (atof nx) (atof ny) 0.0) (atof a))))))
(defun r01:st (h txt / e d)
  (if (setq e (handent h))
    (progn (setq d (entget e)) (entmod (subst (cons 1 txt) (assoc 1 d) d)) (entupd e))))
;; LT h tipo                   tipo de linha da entidade h ("ByLayer" = o da layer); polilinha ganha a geração contínua do
;;                             tracejado (70 bit 128), senão o padrão recomeça em cada vértice e trecho curto sai cheio
(defun r01:lt (h tipo / e d)
  (if (setq e (handent h))
    (progn (setq d (entget e))
           (setq d (if (assoc 6 d) (subst (cons 6 tipo) (assoc 6 d) d) (append d (list (cons 6 tipo)))))
           (if (and (= (cdr (assoc 0 d)) "LWPOLYLINE") (assoc 70 d))
             (setq d (subst (cons 70 (logior 128 (cdr (assoc 70 d)))) (assoc 70 d) d)))
           (entmod d) (entupd e))))
(defun c:revr01 ( / f ln c n saida)
  (vl-load-com)
  (setvar "CMDECHO" 0) (setvar "TILEMODE" 1) (setvar "OSMODE" 0) (setvar "COPYMODE" 1)
  (r01:estilo)
  (setq f (open (getenv "REV_CMD") "r" "utf8") n 0)
  (while (setq ln (read-line f))
    (setq c (r01:split ln))
    (cond
      ((= (car c) "LAYER") (r01:layer (nth 1 c) (atoi (nth 2 c)) (nth 3 c)))
      ((= (car c) "PL") (r01:pl (nth 1 c) (nth 2 c) (cdddr c)))
      ((= (car c) "CLOUD") (r01:cloud (nth 1 c) (atof (nth 2 c)) (atof (nth 3 c)) (atof (nth 4 c))))
      ((= (car c) "TX") (r01:tx (nth 1 c) (atof (nth 2 c)) (atof (nth 3 c)) (atof (nth 4 c)) (atof (nth 5 c)) (nth 6 c)))
      ((= (car c) "MT") (r01:mt (nth 1 c) (atof (nth 2 c)) (atof (nth 3 c)) (atof (nth 4 c)) (atof (nth 5 c)) (nth 6 c)))
      ((= (car c) "DEL") (r01:del (nth 1 c)))
      ((= (car c) "PLC") (r01:plc (nth 1 c) (nth 2 c) (cdddr c)))
      ((= (car c) "REPL") (r01:repl (nth 1 c) (cddr c)))
      ((= (car c) "MV") (r01:mv (nth 1 c) (nth 2 c) (nth 3 c)))
      ((= (car c) "VTX") (r01:vtx (nth 1 c) (nth 2 c) (nth 3 c) (nth 4 c)))
      ((= (car c) "TXC") (r01:txc (nth 1 c) (nth 2 c) (nth 3 c) (nth 4 c) (nth 5 c)))
      ((= (car c) "RT") (r01:rt (nth 1 c) (nth 2 c) (nth 3 c) (nth 4 c)))
      ((= (car c) "CPR") (r01:cpr (nth 1 c) (nth 2 c) (nth 3 c) (nth 4 c) (nth 5 c) (nth 6 c)))
      ((= (car c) "ST") (r01:st (nth 1 c) (nth 2 c)))
      ((= (car c) "LT") (r01:lt (nth 1 c) (nth 2 c))))
    (setq n (1+ n)))
  (close f)
  (command "_.ZOOM" "_E")
  (setq saida (getenv "REV_OUT"))
  (princ (strcat "\nREVR01: " (itoa n) " linhas -> " saida "\n"))
  (command "_.SAVEAS" "2018" saida)
  (princ))
